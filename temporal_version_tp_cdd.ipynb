    "conflicto_csv.loc[3, \"Sleep_Stage\"] = \"N2\"\n",
    "comprobar_rechazo_csv(\"Rechazar la misma clave con datos contradictorios\", conflicto_csv)\n",
    "instante_csv = muestra_csv.copy()\n",
    "instante_csv.loc[1, \"tiempo_relativo_segundos\"] = 0.0\n",
