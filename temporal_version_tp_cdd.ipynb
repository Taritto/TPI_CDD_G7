   "source": "## 2.2 Análisis de Variables Categóricas",
   "metadata": {
    "_cell_guid": "feb0c181-d6c3-40e8-8a8b-4e1f1088e210",
    "_uuid": "1266bdc9-aa62-4a2e-b9bc-51aaa47e1c0c",
